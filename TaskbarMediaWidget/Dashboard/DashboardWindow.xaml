<ui:FluentWindow x:Class="TaskbarMediaWidget.Dashboard.DashboardWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:dash="clr-namespace:TaskbarMediaWidget.Dashboard"
                  Title="Echo Flyout"
                  Icon="/Assets/app.ico"
                  Width="960" Height="680" MinWidth="800" MinHeight="560"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Acrylic"
                  WindowCornerPreference="Round"
                  Background="Transparent"
                  Foreground="#F4F4F6">
    <!-- Acrylic + a Transparent window Background is what makes the glass real: DWM frosts
         whatever is actually behind the window, and the styling below composites onto it. An
         opaque Background here would hide the backdrop entirely and leave the "glass" sitting on
         a solid slab. DashboardWindow.xaml.cs sets the DWM dark-mode flag in SourceInitialized —
         it must happen *before* the backdrop is composited, or DWM frosts in light mode and the
         wallpaper washes out the light text. -->

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Base Colors & Accent Brushes -->
            <SolidColorBrush x:Key="AccentCyan" Color="#4CC2FF"/>
            <SolidColorBrush x:Key="AccentViolet" Color="#9D5BD2"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A2A2AD"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#71717A"/>

            <!-- Frosted Glass Card Style -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                            <GradientStop Color="#0DFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#38FFFFFF" Offset="0"/>
                            <GradientStop Color="#12FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero Glass Card Style with Accent Border Glow -->
            <Style x:Key="GlassHeroCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#24FFFFFF" Offset="0"/>
                            <GradientStop Color="#10FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#664CC2FF" Offset="0"/>
                            <GradientStop Color="#2A9D5BD2" Offset="0.5"/>
                            <GradientStop Color="#1AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Glass Nav Item Style -->
            <Style x:Key="GlassNavItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Foreground" Value="#B0B0BA"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <!-- Selection indicator bar -->
                                    <Border x:Name="accent" Width="3" Height="20" CornerRadius="2"
                                            HorizontalAlignment="Left" Background="#4CC2FF" Visibility="Collapsed"/>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                                    <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Glass Choice Chip (Radio button) -->
            <Style x:Key="GlassChoiceChip" TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="#C2C2CD"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="chip" CornerRadius="16" Padding="16,8"
                                    Background="#10FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="#1EFFFFFF"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#404CC2FF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chip" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#404CC2FF" Offset="0"/>
                                                <GradientStop Color="#254CC2FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#4CC2FF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Glass Action Button -->
            <Style x:Key="GlassActionButton" TargetType="Button">
                <Setter Property="Background" Value="#18FFFFFF"/>
                <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#F4F4F6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#664CC2FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4CC2FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Glass Primary Glow Button -->
            <Style x:Key="GlassPrimaryButton" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#334CC2FF" Offset="0"/>
                            <GradientStop Color="#1A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#664CC2FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#554CC2FF" Offset="0"/>
                                                <GradientStop Color="#304CC2FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#994CC2FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#704CC2FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Transport Glass Circle Button -->
            <Style x:Key="GlassCircleButton" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="18" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4CC2FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Typography Styles -->
            <Style x:Key="PageHeaderTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <Style x:Key="PageHeaderSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="0,3,0,18"/>
            </Style>

            <Style x:Key="CardHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <Style x:Key="CardSubtext" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <!-- Main Window Canvas with Glassmorphic Ambient Glow Lights -->
    <Grid>
        <!-- Frost veil: sits between the live acrylic backdrop and everything else. Pure acrylic
             alone is at the mercy of the wallpaper — over a bright one, light text stops being
             readable. This cool-tinted veil holds contrast steady on any background while still
             letting the frost read through. Raise the alphas for more opacity, lower them for
             more see-through. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#6E0B0E14" Offset="0"/>
                    <GradientStop Color="#4D111827" Offset="0.5"/>
                    <GradientStop Color="#6E0A0D13" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Frost sheen: the faint diagonal catch of light across frozen glass, plus a brighter
             top edge where the pane meets the light. Pure decoration over the blur. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.85">
                    <GradientStop Color="#14FFFFFF" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="0.28"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.62"/>
                    <GradientStop Color="#0AB8E8FF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Ambient Illumination Backdrop (Lighting Orbs) -->
        <Grid IsHitTestVisible="False">
            <!-- Top Right Cyan Glow -->
            <Ellipse Width="450" Height="450" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-100,0">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#2400A3FF" Offset="0"/>
                        <GradientStop Color="#0000A3FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Left Center Violet Glow -->
            <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-120,50,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#1E7C4DFF" Offset="0"/>
                        <GradientStop Color="#007C4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Bottom Accent Glow -->
            <Ellipse Width="550" Height="300" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-150">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#160078D4" Offset="0"/>
                        <GradientStop Color="#000078D4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Main Window Structure -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Fluent TitleBar -->
            <ui:TitleBar Grid.Row="0" Title="" ShowMaximize="True"/>

            <!-- Content Area: Sidebar + Pages -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Frosted Glass Sidebar -->
                <Border Grid.Column="0" Margin="14,0,0,16" CornerRadius="14"
                        Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Direction="0" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>
                    <Grid Margin="12,16,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App Brand Header -->
                        <Grid Grid.Row="0" Margin="4,2,4,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Glowing App Logo Badge -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                    BorderBrush="#554CC2FF" BorderThickness="1" Margin="0,0,12,0"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#404CC2FF" Offset="0"/>
                                        <GradientStop Color="#207C4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image Source="/Assets/app.png" Width="40" Height="40"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Echo Flyout" FontWeight="SemiBold" FontSize="14.5" Foreground="#FFFFFF"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#00E676" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="System Active" FontSize="11" Foreground="#00E676" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Navigation Items -->
                        <ListBox x:Name="NavList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource GlassNavItemStyle}"
                                 SelectionChanged="NavList_SelectionChanged">
                            <!-- 0: Home -->
                            <ListBoxItem IsSelected="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 10,20 L 10,14 L 14,14 L 14,20 L 19,20 L 19,12 L 22,12 L 12,3 L 2,12 L 5,12 L 5,20 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Home" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- 1: Taskbar Widget -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 3,4 C 1.9,4 1,4.9 1,6 L 1,18 C 1,19.1 1.9,20 3,20 L 21,20 C 22.1,20 23,19.1 23,18 L 23,6 C 23,4.9 22.1,4 21,4 Z M 3,16 L 21,16 L 21,18 L 3,18 Z M 5,17 L 7,17 L 7,17.5 L 5,17.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Taskbar Widget" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- 2: Next Track Flyout -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 18,16 L 18,11 C 18,7.9 16.3,5.3 13.5,4.6 L 13.5,4 C 13.5,3.2 12.8,2.5 12,2.5 C 11.2,2.5 10.5,3.2 10.5,4 L 10.5,4.6 C 7.6,5.3 6,7.9 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 Z M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Next Track Flyout" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- 3: System -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 20,3 L 4,3 C 2.9,3 2,3.9 2,5 L 2,15 C 2,16.1 2.9,17 4,17 L 10,17 L 10,19 L 8,19 L 8,21 L 16,21 L 16,19 L 14,19 L 14,17 L 20,17 C 21.1,17 22,16.1 22,15 L 22,5 C 22,3.9 21.1,3 20,3 Z M 20,15 L 4,15 L 4,5 L 20,5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="System" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- 4: About -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 13,17 L 11,17 L 11,11 L 13,11 Z M 13,9 L 11,9 L 11,7 L 13,7 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="About" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- Sidebar Footer -->
                        <Border Grid.Row="2" CornerRadius="10" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Running in Tray" FontSize="11" FontWeight="SemiBold" Foreground="#4CC2FF"/>
                                <TextBlock Text="Close window to keep running in background." FontSize="10.5" Foreground="#888899" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <Button Content="View Logs" Style="{StaticResource GlassActionButton}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="11.5" Click="OpenLogs_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,0,24,20"
                              dash:SmoothScroll.IsEnabled="True" CanContentScroll="False">
                    <Grid>
                        <!-- ==================== PAGE 0: HOME ==================== -->
                        <StackPanel x:Name="PageHome">
                            <TextBlock Text="Home" Style="{StaticResource PageHeaderTitle}"/>
                            <TextBlock Text="Overview of active media playback and widget control" Style="{StaticResource PageHeaderSubtitle}"/>

                            <!-- Live "Now Playing" Glass Player Card -->
                            <Border Style="{StaticResource GlassHeroCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Margin="0"/>
                                            <Border CornerRadius="10" Background="#244CC2FF" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="LiveAppBadge" Text="Spotify" FontSize="10" FontWeight="SemiBold" Foreground="#4CC2FF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="LiveStatusText" Text="Live SMTC Stream" HorizontalAlignment="Right" FontSize="11" Foreground="#00E676" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Player Body -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Artwork with Frosted Border -->
                                        <Border x:Name="LiveArtworkBorder" Grid.Column="0" Width="68" Height="68" CornerRadius="10"
                                                ClipToBounds="True" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Fallback Music Note Graphic -->
                                                <Path x:Name="LiveArtworkFallback" Data="M 12,3 L 12,13.5 C 11.2,13.2 10.1,13 9,13 C 6.8,13 5,14.3 5,16 C 5,17.7 6.8,19 9,19 C 11.2,19 13,17.7 13,16 L 13,7 L 19,7 L 19,3 Z"
                                                      Fill="#44FFFFFF" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Real Image -->
                                                <Image x:Name="LiveArtworkImage" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Song Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LiveSongTitle" Text="No media playing" FontSize="17" FontWeight="Bold"
                                                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="LiveSongArtist" Text="Start playback on Spotify, browser, or media player"
                                                       FontSize="13" Foreground="#B4B4C2" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="LiveSongAlbum" Text="" FontSize="11.5" Foreground="#808090"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Transport Glass Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Previous Button -->
                                            <Button Style="{StaticResource GlassCircleButton}" ToolTip="Previous Track" Click="PlayerPrev_Click">
                                                <Path Data="M 10,2 L 10,14 L 2,8 Z M 2,2 L 2,14" Fill="#F0F0F4" Stretch="Uniform" Width="12" Height="12"/>
                                            </Button>
                                            <!-- Play / Pause Button -->
                                            <Button x:Name="LivePlayPauseBtn" Style="{StaticResource GlassCircleButton}" Width="42" Height="42"
                                                    Background="#334CC2FF" BorderBrush="#804CC2FF" ToolTip="Play / Pause" Click="PlayerPlayPause_Click">
                                                <Path x:Name="LivePlayPauseIcon" Data="M 3,2 L 13,8 L 3,14 Z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14"/>
                                            </Button>
                                            <!-- Next Button -->
                                            <Button Style="{StaticResource GlassCircleButton}" ToolTip="Next Track" Click="PlayerNext_Click">
                                                <Path Data="M 2,2 L 10,8 L 2,14 Z M 10,2 L 10,14" Fill="#F0F0F4" Stretch="Uniform" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Quick Toggles Grid -->
                            <TextBlock Text="QUICK CONTROLS" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Taskbar Widget Master Switch -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <StackPanel Margin="0,0,60,0">
                                            <TextBlock Text="Taskbar Widget" Style="{StaticResource CardHeader}"/>
                                            <TextBlock Text="Display media info flush on taskbar" Style="{StaticResource CardSubtext}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="HomeWidgetToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="HomeWidgetToggle_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Flyout Master Switch -->
                                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <StackPanel Margin="0,0,60,0">
                                            <TextBlock Text="Next Track Flyout" Style="{StaticResource CardHeader}"/>
                                            <TextBlock Text="Pop up notification when song changes" Style="{StaticResource CardSubtext}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="HomeFlyoutToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="HomeFlyoutToggle_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 3: Idle Mascot Switch -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <StackPanel Margin="0,0,60,0">
                                            <TextBlock Text="Idle Mascot" Style="{StaticResource CardHeader}"/>
                                            <TextBlock Text="Show animated buddy when playback stops" Style="{StaticResource CardSubtext}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="HomeIdleToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="HomeIdleToggle_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Card 4: Run At Startup Switch -->
                                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <StackPanel Margin="0,0,60,0">
                                            <TextBlock Text="Start With Windows" Style="{StaticResource CardHeader}"/>
                                            <TextBlock Text="Launch silently in tray at sign-in" Style="{StaticResource CardSubtext}"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="HomeStartupToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="StartupToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Quick Action Buttons -->
                            <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="Preview Flyout Toast" Style="{StaticResource GlassPrimaryButton}" Margin="0,0,10,10" Click="TestFlyout_Click"/>
                                <Button Content="Configure Taskbar" Style="{StaticResource GlassActionButton}" Margin="0,0,10,10" Click="NavToWidget_Click"/>
                                <Button Content="Open Settings Folder" Style="{StaticResource GlassActionButton}" Margin="0,0,10,10" Click="OpenSettingsFolder_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- ==================== PAGE 1: TASKBAR WIDGET ==================== -->
                        <StackPanel x:Name="PageWidget" Visibility="Collapsed">
                            <TextBlock Text="Taskbar Widget" Style="{StaticResource PageHeaderTitle}"/>
                            <TextBlock Text="Configure docking position, opacity and auto-hide behavior" Style="{StaticResource PageHeaderSubtitle}"/>

                            <!-- Live Interactive Taskbar Simulation Preview -->
                            <Border Style="{StaticResource GlassHeroCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="LIVE TASKBAR PREVIEW" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Windows Taskbar:" FontSize="11" Foreground="#888899" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="SimTaskbarCentered" Content="Centered Icons" GroupName="SimTaskbar" Style="{StaticResource GlassChoiceChip}" Padding="10,4" FontSize="11" IsChecked="True" Click="SimTaskbar_Changed"/>
                                            <RadioButton x:Name="SimTaskbarLeft" Content="Left Icons" GroupName="SimTaskbar" Style="{StaticResource GlassChoiceChip}" Padding="10,4" FontSize="11" Click="SimTaskbar_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mock Windows 11 Taskbar Frame -->
                                    <Border Height="44" CornerRadius="8" Background="#161822" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="10,0">
                                        <Grid>
                                            <!-- Windows 11 Start & App icons (switches between Center and Left) -->
                                            <StackPanel x:Name="SimulatedIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Windows Start Button -->
                                                <Border Width="26" Height="26" CornerRadius="4" Background="#1EFFFFFF" Margin="2,0">
                                                    <Path Data="M 2,2 L 6.5,2 L 6.5,6.5 L 2,6.5 Z M 7.5,2 L 12,2 L 12,6.5 L 7.5,6.5 Z M 2,7.5 L 6.5,7.5 L 6.5,12 L 2,12 Z M 7.5,7.5 L 12,7.5 L 12,12 L 7.5,12 Z"
                                                          Fill="#4CC2FF" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Search Pill -->
                                                <Border Width="60" Height="22" CornerRadius="11" Background="#14FFFFFF" Margin="4,0" Padding="8,0">
                                                    <TextBlock Text="Search" FontSize="10" Foreground="#777788" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- App Icons Placeholders -->
                                                <Border Width="24" Height="24" CornerRadius="4" Background="#1AFFFFFF" Margin="2,0"/>
                                                <Border Width="24" Height="24" CornerRadius="4" Background="#1AFFFFFF" Margin="2,0"/>
                                                <Border Width="24" Height="24" CornerRadius="4" Background="#1AFFFFFF" Margin="2,0"/>
                                            </StackPanel>

                                            <!-- Simulated Media Widget in Taskbar (Docks Left or Right) -->
                                            <Border x:Name="SimulatedWidget" Height="32" CornerRadius="6"
                                                    Background="#24FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4" Background="#4CC2FF" Margin="0,0,6,0">
                                                        <Path Data="M 8,3 L 8,9 C 7.5,8.8 7,8.6 6,8.6 C 4.5,8.6 3.5,9.5 3.5,10.7 C 3.5,11.8 4.5,12.7 6,12.7 C 7.5,12.7 8.7,11.8 8.7,10.7 L 8.7,5 L 12,5 L 12,3 Z"
                                                              Fill="#000000" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="Taskbar Track" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="Artist Name" FontSize="8" Foreground="#A0A0B0"/>
                                                    </StackPanel>
                                                    <!-- Mini Controls -->
                                                    <Path Data="M 2,1 L 7,5 L 2,9 Z M 7,1 L 7,9" Fill="#FFFFFF" Stretch="Uniform" Width="7" Height="7" Margin="2,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Clock / System Tray Area (Right) -->
                                            <StackPanel x:Name="SimulatedTray" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <TextBlock Text="ENG" FontSize="9" Foreground="#888899" Margin="0,0,6,0"/>
                                                <TextBlock Text="12:00 PM" FontSize="9.5" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Collision Warning Banner (Only shows when left-aligned icons conflict with left-docked widget) -->
                                    <Border x:Name="PreviewWarningBanner" Margin="0,10,0,0" CornerRadius="8" Background="#26FFB74D" BorderBrush="#80FFB74D" BorderThickness="1" Padding="12,8" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⚠️" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="Taskbar icons are left-aligned! Docking on the left may crowd the Start button. For the best experience, center your Windows taskbar icons or dock the widget near the system tray."
                                                       FontSize="11.5" Foreground="#FFE082" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Settings Cards -->
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Enable taskbar widget" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Show media info and playback controls on the taskbar" Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="WidgetEnabledToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Opacity Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Content Opacity" Style="{StaticResource CardHeader}"/>
                                            <TextBlock Text="Controls the transparency of the widget against the taskbar surface" Style="{StaticResource CardSubtext}"/>
                                        </StackPanel>
                                        <Border CornerRadius="8" Background="#204CC2FF" BorderBrush="#4CC2FF" BorderThickness="1" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="OpacityValue" Text="85%" FontWeight="Bold" FontSize="13" Foreground="#4CC2FF"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Margin="0,16,0,0"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="OpacitySlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Dock Side Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Dock Side Placement" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Which section of the Windows taskbar the widget aligns to" Style="{StaticResource CardSubtext}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="DockTray" Content="Near System Tray (Right)" GroupName="Dock" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="DockStart" Content="Near Start Button (Left)" GroupName="Dock" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Taskbar Setup Recommendation Guide -->
                            <Border Style="{StaticResource GlassCard}" Background="#124CC2FF" BorderBrush="#334CC2FF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#244CC2FF" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 13,17 L 11,17 L 11,11 L 13,11 Z M 13,9 L 11,9 L 11,7 L 13,7 Z"
                                              Fill="#4CC2FF" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="RECOMMENDED TASKBAR SETUP" FontSize="11" FontWeight="Bold" Foreground="#4CC2FF"/>
                                        <TextBlock x:Name="DockRecommendationText" FontSize="12.5" Foreground="#E0E0EA" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="For the best experience when docking Near Start Button (Left), keep your Windows Taskbar icons Centered. This leaves the entire left side open for the media widget."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Taskbar Settings" Style="{StaticResource GlassPrimaryButton}" Padding="12,7" FontSize="12" VerticalAlignment="Center" Click="OpenWindowsTaskbarSettings_Click"/>
                                </Grid>
                            </Border>

                            <!-- Auto Hide Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Inactivity Auto-Hide" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Automatically hide the widget after media playback has ceased" Style="{StaticResource CardSubtext}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="Idle1m" Content="1 min" GroupName="Idle" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="Idle5m" Content="5 min" GroupName="Idle" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="Idle10m" Content="10 min" GroupName="Idle" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="IdlePermanent" Content="Permanent (Never)" GroupName="Idle" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Idle Animation Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Idle Mascot Animation" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Show a friendly animated companion hopping across the strip when paused" Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="IdleAnimationToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Ad / incidental audio filtering -->
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Ignore Ads &amp; Incidental Audio" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Skip sessions with no artist and no cover art — web ads and autoplaying clips, which Windows otherwise reports the same as real media" Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="FilterAdsToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Minimum track length -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Minimum Track Length" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Also ignore anything shorter than this. Catches ads that do carry artwork — but will hide genuinely short clips such as Shorts and Reels" Style="{StaticResource CardSubtext}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="MinLenOff" Content="Off" GroupName="MinLen" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="MinLen30" Content="30s" GroupName="MinLen" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="MinLen60" Content="60s" GroupName="MinLen" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="MinLen90" Content="90s" GroupName="MinLen" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== PAGE 2: NEXT TRACK FLYOUT ==================== -->
                        <StackPanel x:Name="PageFlyout" Visibility="Collapsed">
                            <TextBlock Text="Next Track Flyout" Style="{StaticResource PageHeaderTitle}"/>
                            <TextBlock Text="Screen-corner popup notification displaying new track details" Style="{StaticResource PageHeaderSubtitle}"/>

                            <!-- Interactive Screen Corner Preview Card -->
                            <Border Style="{StaticResource GlassHeroCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="CORNER PLACEMENT PREVIEW" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <Button Content="Test Flyout Now" Style="{StaticResource GlassPrimaryButton}" HorizontalAlignment="Right" Padding="12,5" FontSize="11.5" Click="TestFlyout_Click"/>
                                    </Grid>

                                    <!-- Mock Desktop Monitor Screen -->
                                    <Border Height="180" CornerRadius="10" Background="#14151F" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12">
                                        <Grid>
                                            <!-- Top-Left Corner Hotspot -->
                                            <Border x:Name="PreviewCornerTL" Width="100" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    CornerRadius="6" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6"
                                                    Cursor="Hand" MouseLeftButtonDown="CornerPreview_Click" Tag="TopLeft">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Top-Left" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                                    <TextBlock Text="Flyout Zone" FontSize="8.5" Foreground="#777788"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Top-Right Corner Hotspot -->
                                            <Border x:Name="PreviewCornerTR" Width="100" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    CornerRadius="6" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6"
                                                    Cursor="Hand" MouseLeftButtonDown="CornerPreview_Click" Tag="TopRight">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Top-Right" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                                    <TextBlock Text="Flyout Zone" FontSize="8.5" Foreground="#777788"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Center Screen Hint -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M 20,3 L 4,3 C 2.9,3 2,3.9 2,5 L 2,15 C 2,16.1 2.9,17 4,17 L 10,17 L 10,19 L 8,19 L 8,21 L 16,21 L 16,19 L 14,19 L 14,17 L 20,17 C 21.1,17 22,16.1 22,15 L 22,5 C 22,3.9 21.1,3 20,3 Z"
                                                      Fill="#2AFFFFFF" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Click a corner or chips below to position" FontSize="11" Foreground="#555566" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <!-- Bottom-Left Corner Hotspot -->
                                            <Border x:Name="PreviewCornerBL" Width="100" Height="46" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    CornerRadius="6" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6"
                                                    Cursor="Hand" MouseLeftButtonDown="CornerPreview_Click" Tag="BottomLeft">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Bottom-Left" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                                    <TextBlock Text="Flyout Zone" FontSize="8.5" Foreground="#777788"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bottom-Right Corner Hotspot -->
                                            <Border x:Name="PreviewCornerBR" Width="100" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    CornerRadius="6" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6"
                                                    Cursor="Hand" MouseLeftButtonDown="CornerPreview_Click" Tag="BottomRight">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Bottom-Right" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                                    <TextBlock Text="Flyout Zone" FontSize="8.5" Foreground="#777788"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Enable Flyout Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Enable next-track flyout" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Pop up a card showing artwork, title, and artist on genuine track changes" Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="FlyoutEnabledToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Corner Selection Chips -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Screen Corner Position" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Which monitor corner the popup notification surfaces in" Style="{StaticResource CardSubtext}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="CornerTopLeft" Content="Top-Left" GroupName="Corner" Style="{StaticResource GlassChoiceChip}" Click="CornerChip_Changed"/>
                                        <RadioButton x:Name="CornerTopRight" Content="Top-Right" GroupName="Corner" Style="{StaticResource GlassChoiceChip}" Click="CornerChip_Changed"/>
                                        <RadioButton x:Name="CornerBottomLeft" Content="Bottom-Left" GroupName="Corner" Style="{StaticResource GlassChoiceChip}" Click="CornerChip_Changed"/>
                                        <RadioButton x:Name="CornerBottomRight" Content="Bottom-Right" GroupName="Corner" Style="{StaticResource GlassChoiceChip}" Click="CornerChip_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Duration Selection Chips -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Display Duration" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="How many seconds the popup remains visible before smoothly fading away" Style="{StaticResource CardSubtext}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="Dur2" Content="2 seconds" GroupName="Dur" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="Dur4" Content="4 seconds" GroupName="Dur" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="Dur6" Content="6 seconds" GroupName="Dur" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                        <RadioButton x:Name="Dur8" Content="8 seconds" GroupName="Dur" Style="{StaticResource GlassChoiceChip}" Click="Setting_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== PAGE 3: SYSTEM ==================== -->
                        <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                            <TextBlock Text="System" Style="{StaticResource PageHeaderTitle}"/>
                            <TextBlock Text="Display mapping, Windows startup, and diagnostics" Style="{StaticResource PageHeaderSubtitle}"/>

                            <!-- Display Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Target Display" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Select which monitor's taskbar the media widget should dock to" Style="{StaticResource CardSubtext}"/>
                                    <ComboBox x:Name="DisplayCombo" Margin="0,14,0,0" DisplayMemberPath="Label"
                                              Background="#18FFFFFF" Foreground="#FFFFFF"
                                              SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Start with Windows Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Start With Windows" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Silently launches with Windows into your saved preferences (no dashboard popup)" Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="StartupToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="StartupToggle_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Data & File Paths Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Configuration &amp; Diagnostics" Style="{StaticResource CardHeader}"/>
                                    <TextBlock Text="Direct access to live settings JSON and diagnostic logs" Style="{StaticResource CardSubtext}"/>

                                    <Grid Margin="0,16,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Settings File" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            <TextBlock x:Name="SettingsPathLabel" Text="%LocalAppData%\TaskbarMediaWidget\settings.json" FontSize="11" Foreground="#777788"/>
                                        </StackPanel>
                                        <Button Content="Open Folder" Style="{StaticResource GlassActionButton}" HorizontalAlignment="Right" Padding="12,6" FontSize="12" Click="OpenSettingsFolder_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#14FFFFFF" Margin="0,8"/>

                                    <Grid Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Diagnostic Log" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            <TextBlock x:Name="LogPathLabel" Text="%LocalAppData%\TaskbarMediaWidget\log.txt" FontSize="11" Foreground="#777788"/>
                                        </StackPanel>
                                        <Button Content="View Log" Style="{StaticResource GlassActionButton}" HorizontalAlignment="Right" Padding="12,6" FontSize="12" Click="OpenLogs_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== PAGE 4: ABOUT ==================== -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource PageHeaderTitle}"/>
                            <TextBlock Text="Architecture, specifications, and project details" Style="{StaticResource PageHeaderSubtitle}"/>

                            <!-- Hero App Info Card -->
                            <Border Style="{StaticResource GlassHeroCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="76" Height="76" CornerRadius="18"
                                            BorderBrush="#664CC2FF" BorderThickness="1.5" Margin="0,0,20,0"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#454CC2FF" Offset="0"/>
                                                <GradientStop Color="#257C4DFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Image Source="/Assets/app.png" Width="66" Height="66"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Echo Flyout" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12" Foreground="#4CC2FF" Margin="0,2,0,0"/>
                                        <TextBlock Text="A Windows 11 media controller that docks flush into the taskbar — album art, track info, and transport controls drawn directly onto the bar."
                                                   FontSize="12.5" Foreground="#B0B0C0" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Spec Highlights Grid -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Text="Zero Polling Architecture" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Taps directly into Windows GSMTC / WinRT events for track updates and transport control." Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Text="Per-Monitor-V2 DPI Aware" Style="{StaticResource CardHeader}"/>
                                        <TextBlock Text="Physical coordinate math and Win32 AppBar synchronization ensure razor-sharp alignment on any monitor." Style="{StaticResource CardSubtext}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Technology Details Card -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Built With" Style="{StaticResource CardHeader}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,5" Margin="0,0,8,8">
                                            <TextBlock Text=".NET 8 (C# 12)" FontSize="11.5" Foreground="#EEEEEE"/>
                                        </Border>
                                        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,5" Margin="0,0,8,8">
                                            <TextBlock Text="WPF &amp; Layered Windows" FontSize="11.5" Foreground="#EEEEEE"/>
                                        </Border>
                                        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,5" Margin="0,0,8,8">
                                            <TextBlock Text="Windows SMTC (WinRT)" FontSize="11.5" Foreground="#EEEEEE"/>
                                        </Border>
                                        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,5" Margin="0,0,8,8">
                                            <TextBlock Text="Win32 User32 &amp; Shell32" FontSize="11.5" Foreground="#EEEEEE"/>
                                        </Border>
                                        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,5" Margin="0,0,8,8">
                                            <TextBlock Text="WPF-UI Fluent Controls" FontSize="11.5" Foreground="#EEEEEE"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
