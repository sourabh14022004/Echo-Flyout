<Window x:Class="TaskbarMediaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widget="clr-namespace:TaskbarMediaWidget.Widget"
        Title="Echo Flyout"
        Icon="/Assets/app.ico"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowActivated="False">
    <!-- AllowsTransparency="True" + a transparent background is WPF's standard layered-window
         transparency, and it's what makes the widget blend into the taskbar: no card, no surface
         of its own, just album art / text / controls drawn straight onto the bar. (The earlier
         blank-render bug came from the invalid pairing of AllowsTransparency="False" WITH a
         transparent background, and from the DWM Mica attribute — neither is used any more.) -->

    <Window.Resources>
        <!-- Swapped in code-behind by ThemeWatcher for dark/light mode. -->
        <SolidColorBrush x:Key="WidgetForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="WidgetSecondaryForegroundBrush" Color="#FFB3B3B3"/>
        <SolidColorBrush x:Key="WidgetHoverBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="WidgetPressedBrush" Color="#4DFFFFFF"/>

        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WidgetPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- RootBorder is purely the show/hide fade host now — no background, no corners, nothing
         that would read as a separate surface sitting on top of the taskbar. -->
    <Border x:Name="RootBorder" Background="Transparent" Padding="10,0" Opacity="0">
        <Border.Resources>
            <Storyboard x:Key="FadeInStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
            </Storyboard>
            <Storyboard x:Key="FadeOutStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
            </Storyboard>
        </Border.Resources>

        <!-- ContentRoot carries the user's Opacity setting (set in ApplyTheme) so it covers both
             layers below. Keeping it on an inner element means it composes with the show/hide fade
             on RootBorder.Opacity instead of the two fighting over the same property.
             The two layers overlap; exactly one is visible at a time (see RenderMedia). -->
        <Grid x:Name="ContentRoot">

        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Album art: sized in code-behind to fit the live taskbar thickness -->
            <Border x:Name="AlbumArtBorder" Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                    ClipToBounds="True" Margin="0,0,8,0" Background="#33808080" VerticalAlignment="Center">
                <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
            </Border>

            <!-- Title / artist -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="No media playing" Foreground="{DynamicResource WidgetForegroundBrush}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="{DynamicResource WidgetSecondaryForegroundBrush}"
                           FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Transport controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="PrevButton" Click="PrevButton_Click" Style="{StaticResource TransportButtonStyle}"
                        ToolTip="Previous">
                    <Path Data="M 10,2 L 10,14 L 2,8 Z M 2,2 L 2,14" Fill="{DynamicResource WidgetForegroundBrush}" Stretch="Uniform" Width="11" Height="11"/>
                </Button>
                <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource TransportButtonStyle}"
                        ToolTip="Play/Pause">
                    <Grid Width="11" Height="11">
                        <Path x:Name="PlayIcon" Data="M 2,2 L 2,14 L 13,8 Z" Fill="{DynamicResource WidgetForegroundBrush}" Stretch="Uniform"/>
                        <Path x:Name="PauseIcon" Data="M 2,2 L 5,2 L 5,14 L 2,14 Z M 9,2 L 12,2 L 12,14 L 9,14 Z"
                              Fill="{DynamicResource WidgetForegroundBrush}" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource TransportButtonStyle}"
                        ToolTip="Next">
                    <Path Data="M 2,2 L 2,14 L 10,8 Z M 10,2 L 10,14" Fill="{DynamicResource WidgetForegroundBrush}" Stretch="Uniform" Width="11" Height="11"/>
                </Button>
            </StackPanel>
        </Grid>

            <!-- Shown instead of the media row when nothing is playing. IsHitTestVisible="False"
                 so it can never swallow a click meant for the taskbar underneath. -->
            <widget:IdleBanner x:Name="IdleBanner" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
