<Window x:Class="TaskbarMediaWidget.Flyout.NextTrackFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now Playing"
        Icon="/Assets/app.ico"
        Width="320" Height="102"
        MinWidth="0" MinHeight="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">
    <!-- Using standard WPF layered window transparency (AllowsTransparency="True" + Background="Transparent")
         so the popup card renders with clean anti-aliased rounded corners and no outer gray DWM acrylic halo. -->
    <Border x:Name="RootBorder" Width="320" Height="102" CornerRadius="8" Padding="16" Opacity="0"
            BorderThickness="1" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <!-- Darker than the dashboard's cards on purpose: those sit on the dashboard's own tinted
             veil, whereas this popup sits directly on whatever happens to be on screen, so it has
             to carry its own contrast. -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C8121722" Offset="0"/>
                <GradientStop Color="#A81A2233" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4CFFFFFF" Offset="0"/>
                <GradientStop Color="#144CC2FF" Offset="0.6"/>
                <GradientStop Color="#12FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <!-- No DropShadowEffect here: the card fills the window edge to edge, so the shadow has no
             room to fall outside and DWM clips it — all it produced was a smudge inside the
             corners. The window's own shadow (from the DWM frame) does the separation instead. -->

        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="10"/>
        </Border.RenderTransform>

        <Border.Resources>
            <Storyboard x:Key="EnterStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.18"/>
            </Storyboard>
        </Border.Resources>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Album art, with a hairline edge so it reads as a pane of its own on the glass -->
            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="10" ClipToBounds="True"
                    Margin="0,0,14,0" BorderThickness="1" BorderBrush="#26FFFFFF">
                <Grid>
                    <Border Background="#2B3242"/>
                    <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="NOW PLAYING" Foreground="#4CC2FF" FontSize="10"
                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock x:Name="TitleText" Foreground="#F4F4F6" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Foreground="#A2A2AD" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
