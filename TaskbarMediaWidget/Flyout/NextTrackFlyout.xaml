<ui:FluentWindow x:Class="TaskbarMediaWidget.Flyout.NextTrackFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Now Playing"
                 Icon="/Assets/app.ico"
                 Width="330" Height="104"
                 MinWidth="0" MinHeight="0"
                 SizeToContent="Manual"
                 WindowStyle="None"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="Manual"
                 Topmost="True"
                 Focusable="False"
                 ShowActivated="False">
    <!-- FluentWindow gets its control template from WPF-UI's theme dictionaries. Without these
         merged in, the default style never resolves, the window ends up with no template — and so
         no ContentPresenter — and renders as a blank grey slab no matter what the content is.
         Scoped to this window (not App.xaml) so the implicit Fluent styles can't reach the
         taskbar widget. -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <!-- Same recipe as the dashboard: an Acrylic backdrop with a Transparent window background so
         DWM frosts whatever is behind, and the dark-mode flag set in SourceInitialized (before the
         first composition) so that frost renders dark rather than washing the wallpaper through
         the light-on-glass text. -->

    <!-- CornerRadius must match the radius DWM clips the window to (WindowCornerPreference="Round"
         == 8 device pixels). Any larger and the crescent between the card's arc and the window's
         clip exposes the bare backdrop as a pale halo around each corner; any smaller and the
         backdrop shows as a squared-off shoulder. UseLayoutRounding keeps the 1px hairline border
         from smearing across two device pixels on fractional-DPI displays. -->
    <Border x:Name="RootBorder" Width="320" CornerRadius="8" Padding="16" Opacity="0"
            BorderThickness="1" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <!-- Darker than the dashboard's cards on purpose: those sit on the dashboard's own tinted
             veil, whereas this popup sits directly on whatever happens to be on screen, so it has
             to carry its own contrast. -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C8121722" Offset="0"/>
                <GradientStop Color="#A81A2233" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4CFFFFFF" Offset="0"/>
                <GradientStop Color="#144CC2FF" Offset="0.6"/>
                <GradientStop Color="#12FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <!-- No DropShadowEffect here: the card fills the window edge to edge, so the shadow has no
             room to fall outside and DWM clips it — all it produced was a smudge inside the
             corners. The window's own shadow (from the DWM frame) does the separation instead. -->

        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="10"/>
        </Border.RenderTransform>

        <Border.Resources>
            <Storyboard x:Key="EnterStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.18"/>
            </Storyboard>
        </Border.Resources>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Album art, with a hairline edge so it reads as a pane of its own on the glass -->
            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="10" ClipToBounds="True"
                    Margin="0,0,14,0" BorderThickness="1" BorderBrush="#26FFFFFF">
                <Grid>
                    <Border Background="#2B3242"/>
                    <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="NOW PLAYING" Foreground="#4CC2FF" FontSize="10"
                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock x:Name="TitleText" Foreground="#F4F4F6" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Foreground="#A2A2AD" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
