<UserControl x:Class="TaskbarMediaWidget.Widget.IdleBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">
    <!-- Fixed width on purpose: the window is SizeToContent="Width" and PositionForTaskbar
         derives Left from ActualWidth, so a banner that resized itself would re-dock the whole
         widget on every frame. Height is left to stretch into the taskbar band. -->

    <Canvas x:Name="Stage" ClipToBounds="True" Background="Transparent">

        <!-- ===== Mascot sprite: a 30x30 box; ground line at y=29 ===== -->
        <Canvas x:Name="Sprite" Width="30" Height="30" Canvas.Bottom="4" Canvas.Left="0">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <!-- Breathing lives on its own transform so the hop's squash/stretch can
                         animate independently without cancelling the ambient loop -->
                    <ScaleTransform x:Name="SpriteBreath" CenterX="15" CenterY="29"/>
                    <!-- Squash/stretch, anchored at the feet so it compresses downward -->
                    <ScaleTransform x:Name="SpriteSquash" CenterX="15" CenterY="29"/>
                    <!-- Facing direction (+1 right / -1 left), anchored at the body centre -->
                    <ScaleTransform x:Name="SpriteFacing" CenterX="15" CenterY="20"/>
                    <!-- Position along the strip (X) and hop height (Y) -->
                    <TranslateTransform x:Name="SpriteTranslate"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Tail: lightning bolt, wags from its base -->
            <Path x:Name="Tail" Fill="#FFE14D" Stroke="#C9A227" StrokeThickness="0.5"
                  Data="M 23,21 L 28,15.5 L 25.5,15 L 29.5,9.5 L 27,15 L 29.5,14.5 Z">
                <Path.RenderTransform>
                    <RotateTransform x:Name="TailRotate" CenterX="23" CenterY="21"/>
                </Path.RenderTransform>
            </Path>

            <!-- Ears: dark full shape with a yellow lower section layered over it, so the tip
                 reads dark without needing two perfectly-aligned outlines -->
            <Canvas x:Name="EarLeft" Width="30" Height="30">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="EarLeftRotate" CenterX="11" CenterY="12.5"/>
                </Canvas.RenderTransform>
                <Path Fill="#3A3A3A" Data="M 10.5,13 L 5.5,0.5 L 14,10 Z"/>
                <Path Fill="#FFE14D" Data="M 10.5,13 L 8.6,8.2 L 14,10 Z"/>
            </Canvas>

            <Canvas x:Name="EarRight" Width="30" Height="30">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="EarRightRotate" CenterX="19" CenterY="12.5"/>
                </Canvas.RenderTransform>
                <Path Fill="#3A3A3A" Data="M 19.5,13 L 24.5,0.5 L 16,10 Z"/>
                <Path Fill="#FFE14D" Data="M 19.5,13 L 21.4,8.2 L 16,10 Z"/>
            </Canvas>

            <!-- Body -->
            <Ellipse Canvas.Left="5" Canvas.Top="10" Width="20" Height="19"
                     Fill="#FFE14D" Stroke="#C9A227" StrokeThickness="0.6"/>

            <!-- Feet -->
            <Ellipse Canvas.Left="8" Canvas.Top="26.6" Width="5.4" Height="2.8" Fill="#E8B830"/>
            <Ellipse Canvas.Left="16.6" Canvas.Top="26.6" Width="5.4" Height="2.8" Fill="#E8B830"/>

            <!-- Cheeks, each with a brighter glow layer that flashes during the spark behaviour -->
            <Ellipse x:Name="CheekGlowLeft" Canvas.Left="5.6" Canvas.Top="18.2" Width="6.8" Height="5.6"
                     Fill="#FFF3A0" Opacity="0"/>
            <Ellipse Canvas.Left="6.5" Canvas.Top="19" Width="5" Height="4" Fill="#FF5C5C"/>

            <Ellipse x:Name="CheekGlowRight" Canvas.Left="17.6" Canvas.Top="18.2" Width="6.8" Height="5.6"
                     Fill="#FFF3A0" Opacity="0"/>
            <Ellipse Canvas.Left="18.5" Canvas.Top="19" Width="5" Height="4" Fill="#FF5C5C"/>

            <!-- Eyes (pupil + highlight grouped so the highlight blinks with the eye) -->
            <Canvas x:Name="EyeLeft" Width="30" Height="30">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="EyeLeftScale" CenterX="11.6" CenterY="17.5"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="10" Canvas.Top="15.5" Width="3.2" Height="4" Fill="#2B2B2B"/>
                <Ellipse Canvas.Left="10.7" Canvas.Top="16.2" Width="1.3" Height="1.3" Fill="White"/>
            </Canvas>

            <Canvas x:Name="EyeRight" Width="30" Height="30">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="EyeRightScale" CenterX="18.6" CenterY="17.5"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="17" Canvas.Top="15.5" Width="3.2" Height="4" Fill="#2B2B2B"/>
                <Ellipse Canvas.Left="17.7" Canvas.Top="16.2" Width="1.3" Height="1.3" Fill="White"/>
            </Canvas>

            <!-- Mouth: opens downward while speaking -->
            <Ellipse x:Name="Mouth" Canvas.Left="13.5" Canvas.Top="21.4" Width="3" Height="1.4" Fill="#8A3B3B">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="MouthScale" CenterX="15" CenterY="21.4"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Spark bolts, hidden until the spark behaviour fires -->
            <Path x:Name="Spark0" Fill="#FFF06A" Opacity="0" Data="M 2,10 L 5,5 L 3.5,5 L 6,1 L 3,5.5 L 4.6,5.5 Z">
                <Path.RenderTransform><ScaleTransform x:Name="Spark0Scale" CenterX="4" CenterY="5.5" ScaleX="0" ScaleY="0"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Spark1" Fill="#FFF06A" Opacity="0" Data="M 25,8 L 28,3 L 26.5,3 L 29,-1 L 26,3.5 L 27.6,3.5 Z">
                <Path.RenderTransform><ScaleTransform x:Name="Spark1Scale" CenterX="27" CenterY="3.5" ScaleX="0" ScaleY="0"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Spark2" Fill="#FFF06A" Opacity="0" Data="M 1,22 L 4,17 L 2.5,17 L 5,13 L 2,17.5 L 3.6,17.5 Z">
                <Path.RenderTransform><ScaleTransform x:Name="Spark2Scale" CenterX="3" CenterY="17.5" ScaleX="0" ScaleY="0"/></Path.RenderTransform>
            </Path>
            <Path x:Name="Spark3" Fill="#FFF06A" Opacity="0" Data="M 26,24 L 29,19 L 27.5,19 L 30,15 L 27,19.5 L 28.6,19.5 Z">
                <Path.RenderTransform><ScaleTransform x:Name="Spark3Scale" CenterX="28" CenterY="19.5" ScaleX="0" ScaleY="0"/></Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- ===== Speech bubble: lives on the stage, not on the sprite, so it never inherits
                   the sprite's horizontal flip ===== -->
        <Border x:Name="Bubble" Canvas.Bottom="22" Canvas.Left="0" Opacity="0"
                Background="#F2F7F7F7" CornerRadius="7" Padding="6,1,6,2">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.6" ScaleY="0.6"/>
                    <TranslateTransform x:Name="BubbleTranslate"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="BubbleText" Text="pika!" FontSize="9" FontWeight="SemiBold"
                       Foreground="#202020"/>
        </Border>
    </Canvas>
</UserControl>
